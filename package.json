{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "build": "bun build ./src/index.html --outdir=public --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "compile": "tsc --ignoreConfig --skipLibCheck --types bun --noEmit false --outDir public --rootDir src src/api/*.ts src/home/*.ts src/app/*.ts src/home/signup/*.ts"
  },
  "dependencies": {
    "2": "^3.0.0",
    "argon": "^2.0.21",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "edgedb": "^2.0.1",
    "express": "^5.2.1",
    "mysql2": "^3.22.2",
    "postgres": "^3.4.9",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/express": "^5.0.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10"
  }
}
